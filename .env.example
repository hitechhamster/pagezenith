# 复制成 .env（**绝不提交**）。生产在服务器上配同样的环境变量。
# 2026-08 卡密化：服务端统一出 key，用户只输卡密。

USE_MOCKS=false

# ── 必填的三个 key（全部服务端出钱）──
OPENROUTER_API_KEY=            # 全站 LLM + embeddings + AI 配图
SERPER_KEY=                    # SERP：内容差距 / Reddit 选题 / 外链拓客
EXA_KEY=                       # 搜索与竞品正文（已取代 Tavily）

# ── 数据源与模型 ──
SERP_PROVIDER=serper
LLM_MODEL=google/gemini-3.1-flash-lite
EMBEDDING_MODEL=openai/text-embedding-3-large
WRITER_IMAGE_MODEL=google/gemini-2.5-flash-image
WRITER_MAX_CONCURRENT=4
# 注：文章写作模型不在这里配 —— 由 billing/pricing.py 的 TIERS 按档位映射。

# ── 抓取（不装 Chromium）──
FETCH_MODE=httpx
MAX_CONCURRENT_RUNS=2
BLOCK_PRIVATE_URLS=true

# ── 计费护栏 ──
BILLING_DB=./data/billing.db   # SQLite 文件；服务器上放持久盘并每日备份
BILLING_CARD_DAILY_LIMIT=200   # 单卡每日点数上限（防盗刷）
BILLING_GLOBAL_DAILY_CNY=300   # 全站每日真实成本熔断（人民币），超了全部 AI 端点 503
BILLING_BAD_KEY_PER_HOUR=20    # 单 IP 每小时无效卡密尝试上限（防爆破）
